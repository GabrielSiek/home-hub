{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "ES2018.Promise", "ES2019.Array", "ES2019.Object", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@tv/*": ["../tv/src/*"] }
  },
  "include": ["src"]
}
